<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flow — Momentum, Mapped</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============ TOKENS ============ */
:root{
  --abyss:#071b26;
  --current:#0d3340;
  --current-2:#123f4d;
  --flow:#2fd6d9;
  --flow-deep:#0f9aa3;
  --surge:#ff6b3d;
  --surge-2:#ff8f5e;
  --foam:#eefbfa;
  --chalk:#a9c8ce;
  --chalk-dim:#7a99a0;
  --ink:#04141c;
  --line:rgba(255,255,255,.09);
  --glass:linear-gradient(160deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
  --radius:20px;
}

*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth; scroll-padding-top:88px;}
body{
  font-family:'Manrope',sans-serif;
  background:var(--abyss);
  color:var(--chalk);
  line-height:1.65;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}
img,svg{display:block; max-width:100%;}
a{color:inherit; text-decoration:none;}
::selection{background:var(--flow); color:var(--ink);}
::-webkit-scrollbar{width:10px;}
::-webkit-scrollbar-track{background:var(--abyss);}
::-webkit-scrollbar-thumb{background:var(--current-2); border-radius:10px;}
::-webkit-scrollbar-thumb:hover{background:var(--flow-deep);}

.container{max-width:1180px; margin:0 auto; padding:0 28px;}

h1,h2,h3{
  font-family:'Bebas Neue',sans-serif;
  font-weight:400;
  color:var(--foam);
  letter-spacing:.02em;
  line-height:1.05;
}

.eyebrow{
  font-family:'IBM Plex Mono',monospace;
  font-size:.76rem;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--flow);
  display:inline-flex;
  align-items:center;
  gap:9px;
}
.eyebrow::before{
  content:'';
  width:16px; height:2px;
  background:var(--surge);
  display:inline-block;
}

.section-title{font-size:clamp(2.1rem,4.6vw,3.3rem); margin:.4em 0 .45em;}
.lead{max-width:560px; font-size:1.05rem; color:var(--chalk);}
section{position:relative; padding:110px 0;}

/* buttons */
.btn{
  position:relative;
  overflow:hidden;
  display:inline-flex;
  align-items:center;
  gap:10px;
  font-family:'IBM Plex Mono',monospace;
  font-size:.85rem;
  font-weight:600;
  letter-spacing:.03em;
  padding:15px 28px;
  border-radius:100px;
  border:none;
  cursor:pointer;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1), box-shadow .35s ease, background .3s ease;
}
.btn-primary{
  background:linear-gradient(120deg, var(--flow), var(--flow-deep));
  color:var(--ink);
  box-shadow:0 8px 24px -8px rgba(47,214,217,.55);
}
.btn-primary:hover{transform:translateY(-3px) scale(1.02); box-shadow:0 14px 30px -8px rgba(47,214,217,.7);}
.btn-primary:active{transform:translateY(-1px) scale(.98);}
.btn-ghost{
  background:transparent;
  color:var(--foam);
  border:1px solid var(--line);
}
.btn-ghost:hover{border-color:var(--flow); color:var(--flow); transform:translateY(-2px);}
.btn-nav{
  font-family:'IBM Plex Mono',monospace;
  font-size:.78rem;
  padding:10px 20px;
  border-radius:100px;
  background:linear-gradient(120deg, var(--flow), var(--flow-deep));
  color:var(--ink);
  font-weight:600;
}
.ripple{
  position:absolute;
  border-radius:50%;
  background:rgba(255,255,255,.55);
  transform:scale(0);
  pointer-events:none;
  animation:rippleAnim .65s ease-out;
}
@keyframes rippleAnim{ to{ transform:scale(1); opacity:0; } }

/* ============ NAV ============ */
.nav{
  position:fixed; top:0; left:0; width:100%; z-index:200;
  padding:20px 0;
  border-bottom:1px solid transparent;
  transition:background .35s ease, border-color .35s ease, padding .35s ease;
}
.nav.scrolled{
  background:rgba(7,27,38,.78);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  border-bottom-color:var(--line);
  padding:14px 0;
}
.nav-inner{display:flex; align-items:center; justify-content:space-between;}
.logo{display:flex; align-items:center; gap:10px; font-family:'Bebas Neue'; font-size:1.5rem; letter-spacing:.05em; color:var(--foam);}
.logo svg{width:26px; height:26px;}
.nav-links{display:flex; align-items:center; gap:34px;}
.nav-links a{
  font-family:'IBM Plex Mono',monospace;
  font-size:.78rem;
  letter-spacing:.06em;
  text-transform:uppercase;
  color:var(--chalk);
  position:relative;
  padding-bottom:4px;
}
.nav-links a::after{
  content:''; position:absolute; left:0; bottom:0; height:1px; width:0;
  background:var(--flow); transition:width .3s ease;
}
.nav-links a:hover{color:var(--foam);}
.nav-links a:hover::after{width:100%;}
.nav-right{display:flex; align-items:center; gap:26px;}
.burger{display:none; flex-direction:column; gap:5px; background:none; border:none; cursor:pointer; padding:6px;}
.burger span{width:22px; height:2px; background:var(--foam); border-radius:2px; transition:all .3s ease;}
.mobile-menu{
  display:none; position:fixed; top:0; right:0; height:100vh; width:min(78vw,320px);
  background:var(--current); z-index:300; padding:28px; flex-direction:column; gap:26px;
  transform:translateX(100%); transition:transform .4s ease; border-left:1px solid var(--line);
}
.mobile-menu.open{transform:translateX(0);}
.mobile-menu a{font-family:'IBM Plex Mono'; font-size:.9rem; color:var(--foam); text-transform:uppercase; letter-spacing:.06em;}
.mobile-close{align-self:flex-end; background:none; border:none; color:var(--foam); font-size:1.4rem; cursor:pointer;}

/* ============ HERO ============ */
.hero{
  min-height:100vh; display:flex; align-items:center; position:relative; overflow:hidden; padding-top:110px;
}
.hero-bg{position:absolute; inset:0; z-index:0; overflow:hidden;}
.blob{position:absolute; border-radius:50%; filter:blur(70px); opacity:.55;}
.blob-1{width:520px; height:520px; background:radial-gradient(circle, var(--flow), transparent 70%); top:-140px; left:-120px; animation:drift1 22s ease-in-out infinite;}
.blob-2{width:460px; height:460px; background:radial-gradient(circle, var(--surge), transparent 70%); bottom:-160px; right:-100px; opacity:.35; animation:drift2 26s ease-in-out infinite;}
.blob-3{width:380px; height:380px; background:radial-gradient(circle, var(--flow-deep), transparent 70%); top:30%; right:10%; opacity:.4; animation:drift3 19s ease-in-out infinite;}
@keyframes drift1{0%,100%{transform:translate(0,0) scale(1);}33%{transform:translate(60px,40px) scale(1.1);}66%{transform:translate(-30px,60px) scale(.94);}}
@keyframes drift2{0%,100%{transform:translate(0,0) scale(1);}50%{transform:translate(-50px,-40px) scale(1.15);}}
@keyframes drift3{0%,100%{transform:translate(0,0) scale(1);}40%{transform:translate(-40px,30px) scale(1.08);}70%{transform:translate(30px,-20px) scale(.92);}}

.bubbles{position:absolute; inset:0; z-index:1; pointer-events:none;}
.bubble{position:absolute; bottom:-40px; border-radius:50%; background:radial-gradient(circle at 30% 30%, rgba(255,255,255,.55), rgba(255,255,255,.05)); animation:bubbleRise linear infinite;}
@keyframes bubbleRise{
  0%{transform:translateY(0) translateX(0); opacity:0;}
  8%{opacity:.55;}
  92%{opacity:.25;}
  100%{transform:translateY(-115vh) translateX(var(--drift,30px)); opacity:0;}
}

.hero-content{position:relative; z-index:2; text-align:center; margin:0 auto;}
.hero-eyebrow{justify-content:center; margin-bottom:22px;}
.hero-title{
  font-size:clamp(4.5rem,14vw,9rem);
  background:linear-gradient(120deg, var(--foam) 30%, var(--flow) 65%, var(--surge) 100%);
  -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;
  letter-spacing:.03em;
}
.hero-sub{
  max-width:620px; margin:26px auto 40px; font-size:1.12rem; color:var(--chalk);
}
.hero-ctas{display:flex; gap:18px; justify-content:center; flex-wrap:wrap;}
.scroll-cue{
  position:absolute; bottom:36px; left:50%; transform:translateX(-50%); z-index:2;
  display:flex; flex-direction:column; align-items:center; gap:8px;
  font-family:'IBM Plex Mono'; font-size:.7rem; letter-spacing:.16em; text-transform:uppercase; color:var(--chalk-dim);
  animation:bob 2.4s ease-in-out infinite;
}
.scroll-cue svg{width:16px; height:16px;}

.hero-pills{position:absolute; z-index:2; display:none;}
.pill-chip{
  position:absolute;
  font-family:'IBM Plex Mono'; font-size:.72rem; letter-spacing:.03em;
  background:var(--glass); border:1px solid var(--line); border-radius:100px;
  padding:9px 16px; color:var(--foam); backdrop-filter:blur(8px);
  animation:bob 5s ease-in-out infinite;
}

/* wave divider */
.wave-divider{position:relative; width:100%; overflow:hidden; line-height:0; height:90px;}
.wave-track{display:flex; width:200%; animation:waveDrift 16s linear infinite;}
.wave-track svg{width:50%; height:90px; flex-shrink:0;}
@keyframes waveDrift{ to{ transform:translateX(-50%); } }

/* ============ MARQUEE ============ */
.marquee{
  overflow:hidden; padding:22px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
  background:rgba(255,255,255,.02);
}
.marquee-track{display:flex; width:max-content; gap:16px; animation:marquee 30s linear infinite;}
@keyframes marquee{ to{ transform:translateX(-50%); } }
.chip{
  font-family:'IBM Plex Mono'; font-size:.82rem; white-space:nowrap;
  border:1px solid rgba(47,214,217,.3); color:var(--chalk); background:rgba(47,214,217,.05);
  padding:9px 20px; border-radius:100px;
}

/* ============ REVEAL ============ */
.reveal{opacity:0; transform:translateY(34px); transition:opacity .8s ease, transform .8s ease;}
.reveal.visible{opacity:1; transform:translateY(0);}

/* ============ STRUCTURE / TIMELINE ============ */
.structure-head{text-align:center; max-width:640px; margin:0 auto 80px;}
.structure-head .eyebrow{justify-content:center;} .structure-head .section-title{margin-top:.4em;}
.structure-head .lead{margin:0 auto;}

.timeline{position:relative; max-width:1020px; margin:0 auto; padding-left:64px;}
.timeline::before{
  content:''; position:absolute; left:19px; top:6px; bottom:6px; width:2px;
  background-image:repeating-linear-gradient(180deg, var(--flow) 0, var(--flow) 40px, var(--surge) 60px, var(--flow) 100px);
  background-size:100% 100px; animation:flowLine 3.2s linear infinite; border-radius:2px;
}
@keyframes flowLine{ to{ background-position:0 100px; } }

.timeline-item{position:relative; margin-bottom:90px;}
.timeline-item:last-child{margin-bottom:0;}
.timeline-dot{
  position:absolute; left:-64px; top:10px; width:18px; height:18px; border-radius:50%;
  background:var(--current-2); border:2px solid var(--flow); transition:box-shadow .4s ease, background .4s ease;
}
.timeline-dot.active{background:var(--flow); box-shadow:0 0 0 8px rgba(47,214,217,.18), 0 0 20px 4px rgba(47,214,217,.5);}

.structure-card{
  background:var(--glass); border:1px solid var(--line); border-radius:var(--radius);
  padding:38px; display:grid; grid-template-columns:1.05fr .95fr; gap:36px; align-items:center;
  transition:border-color .35s ease, transform .35s ease;
}
.structure-card:hover{border-color:rgba(47,214,217,.35); transform:translateY(-4px);}
.tcard-tag{font-family:'IBM Plex Mono'; font-size:.72rem; letter-spacing:.12em; color:var(--surge); text-transform:uppercase;}
.structure-card h3{font-size:2rem; margin:.3em 0 .4em;}
.structure-card p{color:var(--chalk); font-size:.98rem;}

/* mockup frame */
.mockup-frame{
  border:1px solid var(--line); border-radius:14px; overflow:hidden; background:var(--abyss);
  box-shadow:0 20px 40px -20px rgba(0,0,0,.6);
}
.mockup-bar{display:flex; gap:6px; padding:10px 12px; background:var(--current); border-bottom:1px solid var(--line);}
.mockup-bar span{width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,.18);}
.mockup-body{padding:20px;}

/* landing mockup */
.m-line{height:9px; border-radius:4px; background:rgba(255,255,255,.12); margin-bottom:10px;}
.m-line.w60{width:60%;} .m-line.w40{width:40%;} .m-line.w80{width:80%;}
.m-cta{margin-top:16px; display:inline-block; padding:9px 20px; border-radius:100px; font-family:'IBM Plex Mono'; font-size:.72rem; background:linear-gradient(120deg,var(--flow),var(--flow-deep)); color:var(--ink);}

/* auth mockup */
.oauth-row{display:flex; gap:10px; margin-bottom:16px;}
.oauth-circle{
  width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  font-family:'IBM Plex Mono'; font-size:.78rem; font-weight:600; color:var(--foam);
  border:1px solid var(--line); background:rgba(255,255,255,.04);
}
.divider-text{font-family:'IBM Plex Mono'; font-size:.68rem; color:var(--chalk-dim); text-align:center; margin:6px 0 14px; text-transform:uppercase; letter-spacing:.1em;}
.field{height:34px; border-radius:8px; background:rgba(255,255,255,.05); border:1px solid var(--line); margin-bottom:10px;}

/* dashboard mockup */
.dash-grid{display:grid; grid-template-columns:70px 1fr; grid-template-rows:32px 1fr; gap:6px; height:190px;}
.dash-toolbar{grid-column:1/3; background:rgba(255,255,255,.06); border-radius:6px; display:flex; align-items:center; gap:6px; padding:0 10px;}
.dash-toolbar span{width:14px; height:14px; border-radius:4px; background:var(--flow); opacity:.6;}
.dash-toolbar span:nth-child(2){background:var(--surge);}
.dash-toolbar span:nth-child(3){background:var(--flow-deep);}
.dash-side{background:rgba(255,255,255,.05); border-radius:6px;}
.dash-canvas{background:rgba(255,255,255,.03); border-radius:6px; position:relative; padding:10px; display:flex; flex-direction:column; gap:8px;}
.dash-block{height:22px; border-radius:5px; background:linear-gradient(90deg, var(--flow), var(--flow-deep)); opacity:.85; animation:blockPulse 3s ease-in-out infinite;}
.dash-block:nth-child(2){width:70%; background:linear-gradient(90deg, var(--surge), var(--surge-2)); animation-delay:.4s;}
.dash-block:nth-child(3){width:85%; animation-delay:.8s;}
@keyframes blockPulse{0%,100%{opacity:.7;}50%{opacity:1;}}

/* ============ STATS ============ */
.stats{
  display:flex; justify-content:center; gap:0; flex-wrap:wrap; max-width:900px; margin:0 auto;
}
.stat{flex:1; min-width:180px; text-align:center; padding:0 30px; position:relative;}
.stat + .stat::before{content:''; position:absolute; left:0; top:10%; bottom:10%; width:1px; background:var(--line);}
.stat-num{font-family:'Bebas Neue'; font-size:clamp(3rem,7vw,4.6rem); background:linear-gradient(120deg,var(--flow),var(--surge)); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent;}
.stat-label{font-family:'IBM Plex Mono'; font-size:.74rem; letter-spacing:.1em; text-transform:uppercase; color:var(--chalk-dim); margin-top:8px;}

/* ============ GAMIFICATION GRID ============ */
.feature-head{text-align:center; max-width:640px; margin:0 auto 60px;}
.feature-head .eyebrow{justify-content:center;} .feature-head .lead{margin:0 auto;}
.feature-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:20px;}
.feature-card{
  background:var(--glass); border:1px solid var(--line); border-radius:16px; padding:28px 24px;
  transition:transform .35s ease, border-color .35s ease, box-shadow .35s ease;
}
.feature-card:hover{transform:translateY(-6px); border-color:rgba(47,214,217,.4); box-shadow:0 18px 34px -18px rgba(47,214,217,.35);}
.f-icon{
  width:44px; height:44px; border-radius:12px; display:flex; align-items:center; justify-content:center;
  background:linear-gradient(135deg, rgba(47,214,217,.22), rgba(255,107,61,.14)); margin-bottom:16px;
}
.f-icon svg{width:22px; height:22px; stroke:var(--flow);}
.feature-card h3{font-size:1.3rem; margin-bottom:8px; letter-spacing:.01em;}
.feature-card p{font-size:.88rem; color:var(--chalk);}

/* ============ AI COPILOT ============ */
.ai-section{
  background:linear-gradient(180deg, var(--current) 0%, var(--current-2) 100%);
  clip-path:polygon(0 40px, 100% 0, 100% calc(100% - 40px), 0 100%);
  padding:150px 0 170px;
}
.ai-head{text-align:center; max-width:640px; margin:0 auto 56px;}
.ai-head .eyebrow{justify-content:center;} .ai-head .lead{margin:0 auto;}

.chat-panel{
  max-width:600px; margin:0 auto; background:var(--glass); border:1px solid var(--line);
  border-radius:22px; overflow:hidden; box-shadow:0 30px 60px -30px rgba(0,0,0,.7);
}
.chat-header{display:flex; align-items:center; gap:12px; padding:18px 22px; border-bottom:1px solid var(--line); background:rgba(255,255,255,.03);}
.chat-avatar{width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,var(--flow),var(--flow-deep)); display:flex; align-items:center; justify-content:center;}
.chat-avatar svg{width:16px; height:16px; stroke:var(--ink);}
.chat-title{font-family:'IBM Plex Mono'; font-size:.85rem; color:var(--foam); font-weight:600;}
.status-dot{width:8px; height:8px; border-radius:50%; background:#4ade80; margin-left:auto; box-shadow:0 0 0 0 rgba(74,222,128,.6); animation:pulseGlow 2s infinite;}
@keyframes pulseGlow{0%{box-shadow:0 0 0 0 rgba(74,222,128,.55);}70%{box-shadow:0 0 0 8px rgba(74,222,128,0);}100%{box-shadow:0 0 0 0 rgba(74,222,128,0);}}

.chat-body{padding:26px 22px; display:flex; flex-direction:column; gap:20px;}
.msg{max-width:82%; padding:14px 17px; border-radius:16px; font-size:.9rem;}
.msg-user{align-self:flex-end; background:linear-gradient(120deg,var(--flow),var(--flow-deep)); color:var(--ink); border-bottom-right-radius:4px;}
.msg-ai{align-self:flex-start; background:rgba(255,255,255,.06); border:1px solid var(--line); color:var(--chalk); border-bottom-left-radius:4px;}
.msg-label{display:block; font-family:'IBM Plex Mono'; font-size:.66rem; letter-spacing:.08em; text-transform:uppercase; color:var(--surge); margin-bottom:6px;}
.mini-timeline{display:flex; gap:6px; margin-top:12px; flex-wrap:wrap;}
.mini-chip{font-family:'IBM Plex Mono'; font-size:.66rem; padding:5px 10px; border-radius:100px; background:rgba(47,214,217,.14); border:1px solid rgba(47,214,217,.3); color:var(--flow);}
.mini-actions{display:flex; gap:8px; margin-top:12px;}
.mini-btn{font-family:'IBM Plex Mono'; font-size:.68rem; padding:7px 14px; border-radius:100px; border:1px solid var(--line); color:var(--foam); background:rgba(255,255,255,.04); cursor:pointer;}
.mini-btn.primary{background:var(--surge); color:var(--ink); border-color:var(--surge); font-weight:600;}
.typing{align-self:flex-start; display:flex; gap:5px; padding:14px 17px; background:rgba(255,255,255,.06); border:1px solid var(--line); border-radius:16px; border-bottom-left-radius:4px;}
.typing span{width:6px; height:6px; border-radius:50%; background:var(--chalk); animation:typingBounce 1.3s infinite;}
.typing span:nth-child(2){animation-delay:.15s;} .typing span:nth-child(3){animation-delay:.3s;}
@keyframes typingBounce{0%,60%,100%{transform:translateY(0); opacity:.4;}30%{transform:translateY(-5px); opacity:1;}}

/* ============ FINAL CTA ============ */
.final-cta{text-align:center; padding:160px 0 120px;}
.final-cta h2{font-size:clamp(2.6rem,7vw,4.4rem);}
.final-cta .lead{margin:20px auto 40px;}
.pulse-btn{animation:btnPulse 2.6s ease-in-out infinite;}
@keyframes btnPulse{0%,100%{box-shadow:0 8px 24px -8px rgba(47,214,217,.55);}50%{box-shadow:0 8px 34px -4px rgba(47,214,217,.85);}}

/* ============ FOOTER ============ */
footer{border-top:1px solid var(--line); padding:44px 0;}
.footer-inner{display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px;}
.footer-logo{display:flex; align-items:center; gap:9px; font-family:'Bebas Neue'; font-size:1.2rem; color:var(--foam);}
.footer-logo svg{width:20px; height:20px;}
.footer-meta{font-family:'IBM Plex Mono'; font-size:.72rem; color:var(--chalk-dim); letter-spacing:.04em;}
.footer-links{display:flex; gap:24px; font-family:'IBM Plex Mono'; font-size:.75rem; color:var(--chalk);}
.footer-links a:hover{color:var(--flow);}

/* ============ RESPONSIVE ============ */
@media(max-width:900px){
  .nav-links{display:none;}
  .burger{display:flex;}
  .mobile-menu{display:flex;}
  .structure-card{grid-template-columns:1fr;}
  .feature-grid{grid-template-columns:repeat(2,1fr);}
  .timeline{padding-left:48px;}
  .timeline-dot{left:-48px;}
}
@media(max-width:640px){
  section{padding:80px 0;}
  .feature-grid{grid-template-columns:1fr;}
  .stats{flex-direction:column; gap:36px;}
  .stat + .stat::before{display:none;}
  .structure-card{padding:26px;}
  .ai-section{clip-path:none; padding:100px 0;}
  .chat-body{padding:20px 16px;}
  .hero-title{font-size:clamp(3.4rem,18vw,5rem);}
}

@media (prefers-reduced-motion: reduce){
  *{animation-duration:.001ms !important; animation-iteration-count:1 !important; transition-duration:.001ms !important; scroll-behavior:auto !important;}
}
</style>
</head>
<body>

